# mm-agent 本地配置模板：复制为 .env 后按需填写（.env 已 gitignore，绝不提交）。
# 生效方式：common/config.py 启动时自动加载；优先级 = 显式环境变量 > .env > 默认值。
# 改完 .env 重启相关节点即可，无需 setx。

# ── kb 知识库（embedding，SiliconFlow 免费）────────────────
# KB_EMBEDDING_API_KEY=sk-...
# KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# KB_EMBEDDING_MODEL=BAAI/bge-m3

# ── 各节点地址（谁的节点不在本机就指谁的 IP）──────────────
# LLM_HOST=192.168.1.100
# VLLM_MODEL_NAME=qwen3-vl-4b-instruct-awq-4bit
# VISION_FAST_HOST=192.168.1.101
# VISION_HEAVY_HOST=192.168.1.102
# KB_HOST=127.0.0.1

# ── 可选：端口 / 跨域 / mock ──────────────────────────────
# GATEWAY_PORT=8000
# CORS_ALLOW_ORIGINS=http://192.168.1.50:8080,http://localhost:3000
# NODE_MOCK=1

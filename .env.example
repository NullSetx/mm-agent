# ═══════════════════════════════════════════════════════════════════════
#  mm-agent 统一配置 —— 复制成 .env 后按需填写：cp .env.example .env
#  .env 已被 .gitignore 忽略，key 绝不进库。
#
#  优先级：显式环境变量 > 本文件 > 代码默认值
#    · 各节点由 common/config.py 启动时自动加载；
#    · 一键脚本 scripts/mm-agent.sh 也先加载本文件，
#      所以端口 / VLLM_VENV / 显存参数都在这里改，不必每次在命令行前导。
#  改完重启对应节点即可；临时覆盖单个值仍可用命令行前导
#  （例：VLLM_VENV=/x ./scripts/mm-agent.sh start）。
#
#  下面每个变量都标了默认值，**只取消注释你要改的那些**。
# ═══════════════════════════════════════════════════════════════════════


# ── ① 网络：换机器 / 换网段（如校园网远程演示）只改这一段 ──────────────
# 谁的节点不在本机就填谁的 IP；全在本机就整段保持注释。

# LLM_HOST=127.0.0.1              # vLLM 所在机器
# VISION_FAST_HOST=127.0.0.1
# VISION_HEAVY_HOST=127.0.0.1
# KB_HOST=127.0.0.1

# 端口（一般不动；改的话注意别撞车）
# GATEWAY_PORT=8000
# VLLM_PORT=8001
# VISION_FAST_PORT=8101
# VISION_HEAVY_PORT=8102
# KB_PORT=8103

# 浏览器**直连**网关的地址——由前端页面读取（webapp/config.py 的
# AGENT_GATEWAY_URL），不是网关自己用的。远程访问时填成浏览器能访问到的地址，
# 例：AGENT_GATEWAY_URL=http://192.168.1.160:8000
# AGENT_GATEWAY_URL=http://127.0.0.1:8000

# 网关放行的跨域来源。默认 *（全放行）；前端来源固定后建议收紧成完整来源列表，
# 例：CORS_ALLOW_ORIGINS=http://192.168.1.160:8080,http://localhost:8080
# CORS_ALLOW_ORIGINS=*


# ── ② vLLM / 模型 ──────────────────────────────────────────────────────
# vLLM 所在 venv。它和仓库 .venv 依赖冲突、装不到一起，必须分开指。
# 不填会退回脚本默认的 ~/vllm-venv；那个目录不存在的话脚本会直接报错退出，
# 并给出找它的命令（find $HOME -maxdepth 5 -type f -name vllm -path '*/bin/*'）。
# VLLM_VENV=~/vllm-venv

# 权重目录（相对仓库根目录或绝对路径）。留空时脚本退回
# weights/Qwen2.5-VL-3B-Instruct-AWQ；一键脚本的 --model 参数优先于这里。
# VLLM_MODEL_PATH=weights/Qwen3-VL-4B-Instruct-AWQ-4bit

# 服务名：**必须与 vLLM 的 --served-model-name 完全一致**，不一致会健康检查绿、
# 一对话就 502。留空时脚本按模型目录名小写自动推导，并把同一个名字喂给网关，
# 两边必然一致 —— 所以一般不用填，除非你手动起 vLLM 且用了别的名字。
# VLLM_MODEL_NAME=qwen3-vl-4b-instruct-awq-4bit

# chat template。留空时脚本优先用权重目录自带的 chat_template.jinja。
# Qwen3-VL **必须**用自带的那份；仓库里那份 qwen25_tools_chat_template.jinja 是
# Qwen2.5 专用的，套到 Qwen3-VL 上模型看不到工具定义、永远不调工具。
# VLLM_CHAT_TEMPLATE=

# 显存占用比例。本机 LLM + 两个视觉节点**共用一张 16GB 卡**，必须压到 0.5
# （默认 0.9 会占 14.4GB，视觉节点直接 OOM）。只有 vLLM 独占整卡时才调高。
# 注意 llm_node/llm.py 自己的默认值是 0.9，在这里显式写 0.5 能让两边一致。
# VLLM_GPU_MEMORY_UTILIZATION=0.5

# 上下文长度。VL 模型的视觉 token 随分辨率平方增长，4096 对普通照片够用；
# 超大截图会被 vLLM 以 400 拒绝（送给模型的那份图已按 LLM_IMAGE_MAX_SIDE 缩放）。
#
# ⚠ **调大之前先算显存**：KV cache 随它线性增长，而 gpu_memory_utilization=0.5
# 时本机只给得起约 2.9 GiB（一张卡还要跟两个视觉节点共用）。填超了 vLLM 直接
# 起不来，报错里会写明估出来的天花板，照那个数往下取就行，例如：
#   "…estimated maximum model length is 21056"
# 本机现在用 16384（翻倍于默认 4096，又离 21056 有富余）。
# VLLM_MAX_MODEL_LEN=16384

# 【重要】对话历史的**字符**预算。默认自动推导，一般不用手填：
# 网关启动时和每次 /api/health 都会探一次 vLLM，拿它**实际生效**的窗口减去
# 系统提示词 / 工具定义 / 输出 / 图片占的 3500。探不到才退回 VLLM_MAX_MODEL_LEN。
# （按实际窗口而不是按 .env，是因为改了 .env 没重启 vLLM 时两者会不一致。）
#
# 为什么不能只靠"最多保留多少条消息"：一条带附件正文的用户消息就可能几千字，
# 十几条消息就能把窗口顶穿，vLLM 会回 400「maximum context length is N tokens」
# 把整轮对话打断——实测就踩过。超预算时从**最旧的**开始丢，最新的那条一定保留。
#
# 和 MAX_HISTORY_MESSAGES（条数上限）是两道并行的闸，谁先到算谁。
# MAX_HISTORY_CHARS=12884


# ── ③ 常用超参数 ───────────────────────────────────────────────────────
# 单次工具调用 / 单次对话的超时（秒）
# TOOL_TIMEOUT=30
# CHAT_TIMEOUT=60

# 采样参数。**别把 LLM_TEMPERATURE 调成 0**：贪心解码下，只要上下文里出现过
# 重复内容，模型就会一直复读它（实测连发 6 轮「喵」，相邻两轮相似度一路
# 0.24→0.32→0.44→0.86→0.96 收敛成复读）。0.4 也压不住（曲线一模一样），
# 只有模型作者本来配的 0.7 才有效——实测同一测试下相似度平在 0.2~0.36。
# 代价是 4B 的工具调用会比贪心时飘一点，所以也别再加高。
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.8
# LLM_PRESENCE_PENALTY=0.8      # 直接压制逐字复读，设 0 关掉

# 送给模型的图片长边上限（像素）。调大更清晰但更吃上下文，调小更省 token。
# 只影响送给模型的那一份，工具拿到的始终是原图。
# LLM_IMAGE_MAX_SIDE=1024

# vision_heavy（OCR / 风格迁移）的模型空闲多少秒后释放显存。
# 该节点是懒加载策略：低频、模型偏重，用完就还显存。
# VISION_IDLE_TIMEOUT=60

# 读 PDF 时，最多 OCR 几页**扫描页**。电子版 PDF 直接取文本层、几乎不花时间，
# 只有没有文本层的扫描页才走 OCR，而 OCR 一页约 16 秒（首次还要先加载模型）。
# 默认 2 是照着单次工具调用 30 秒的超时定的——**想多读几页扫描件，必须连同
# TOOL_TIMEOUT 一起调大**，只调这边会撞超时、整轮对话报「附件读取失败」。
# DOC_MAX_SCANNED_PAGES=2

# 强制推理设备（cuda / cpu）。留空 = 自动探测，cuda 不可用才退 CPU。
# 部署机 GPU 型号未定，别写死 cuda。
# VISION_DEVICE=


# ── ④ kb 知识库（embedding，SiliconFlow 免费）──────────────────────────
# 没配 key 节点照样能起，只是 kb_search 会返回可读的报错提示。
# KB_EMBEDDING_API_KEY=sk-...
# KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# KB_EMBEDDING_MODEL=BAAI/bge-m3
# KB_EMBEDDING_PROVIDER=api        # api（默认）| local
# KB_EMBEDDING_TIMEOUT=10

# KB_EMBEDDING_PROVIDER=local 时用的本地模型（需装 sentence-transformers）
# KB_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5


# ── ⑤ 权重路径覆盖（一般不用动；留空 = 用默认位置）────────────────────
# YOLO_WEIGHTS=
# CLS_WEIGHTS=
# OCR_MODEL_ID=PaddlePaddle/PaddleOCR-VL-1.6
# OCR_MODEL_PATH=


# ── ⑥ 一键脚本自用 ─────────────────────────────────────────────────────
# MM_PY        仓库 venv 的 python，默认 <repo>/.venv/bin/python
# MM_RUN_DIR   pid / 日志目录，默认 <repo>/.run
# MM_PY=.venv/bin/python
# MM_RUN_DIR=


# ── ⑦ 调试 ─────────────────────────────────────────────────────────────
# 1 = 所有节点返回占位结果，不加载任何模型（不需权重、不占显存），
#     适合只调前端的人。注意 mock 下 vLLM 不会起，健康检查里 all_ok=false 属正常。
# NODE_MOCK=1
